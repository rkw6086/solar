{
  "name": "solar-desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "predev": "node crates/solar-tools/scripts/prepare-native.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "prebuild": "node crates/solar-tools/scripts/prepare-native.mjs",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test:intro": "node --test src/onboarding/birthTimeline.test.mjs",
    "test:chat": "node --test src/components/chatMessages.test.mjs",
    "test:system": "node --test src/components/solarSystemMotion.test.mjs",
    "test:models": "node --test src/components/modelSearch.test.mjs",
    "test:profiles": "node --test src/components/orbitProfile.test.mjs src/components/orbitIdentity.test.mjs",
    "test:tools": "node --test src/components/toolPresentation.test.mjs",
    "test:projects": "node --test src/projectLocation.test.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "version:check": "node scripts/release.mjs check",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:tag": "node scripts/release.mjs tag",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "node node_modules/@tauri-apps/cli/tauri.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "antd": "6.3.5",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-js-cron": "6.0.2",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
